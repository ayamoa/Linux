#!/usr/bin/env bash
# =============================================================================
# Music Organizer - Sort audio files by Artist / Album
# =============================================================================
#
# WHAT IT DOES
#   Scans a folder recursively, reads audio metadata (tags), and moves each
#   file into:  <DEST>/<Artist>/<Album>/<file>
#   Example: "Muse/ Absolution/ Time Is Running Out.mp3"
#
# REQUIREMENTS
#   1. bash  (Git Bash, WSL, Linux, or macOS - all fine)
#   2. ffprobe  (shipped with FFmpeg) available in PATH
#
#   Install FFmpeg:
#     - Windows (Git Bash) : download from https://www.gyan.dev/ffmpeg/builds/
#                            unzip to C:\ffmpeg, add C:\ffmpeg\bin to PATH
#     - WSL / Debian      : sudo apt install ffmpeg
#     - Fedora            : sudo dnf install ffmpeg
#     - Arch              : sudo pacman -S ffmpeg
#     - macOS             : brew install ffmpeg
#
#   Verify installation:
#     ffprobe -version
#
# USAGE
#   chmod +x classer_musique.sh
#   ./classer_musique.sh [SOURCE_DIR] [DEST_DIR]
#
#   - SOURCE_DIR : folder to scan           (default: current directory)
#   - DEST_DIR   : folder to write results  (default: <SOURCE_DIR>/Sorted)
#
#   Examples:
#     ./classer_musique.sh
#     ./classer_musique.sh ~/Music ~/Music/Sorted
#     ./classer_musique.sh "/c/Users/You/Music" "/c/Users/You/Music/Sorted"
#     ./classer_musique.sh "/mnt/c/Users/You/Music"
#
# SUPPORTED FORMATS
#   .mp3  .flac  .m4a  .ogg  .wma  .wav  .aiff
#   (edit the "find" line at the bottom to add more)
#
# SAFETY
#   - Files are moved with "mv -n" : existing files are NEVER overwritten.
#   - Files with no usable tags are skipped and reported.
#   - Folder names are sanitized for cross-platform use (Windows-safe).
#
# =============================================================================

# ---- Parameters ------------------------------------------------------------
SOURCE_DIR="${1:-.}"                # Folder to scan
DEST_DIR="${2:-$SOURCE_DIR/Sorted}" # Folder to receive organized files

# ---- Colors ----------------------------------------------------------------
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m' # No Color

# ---- Pre-flight checks -----------------------------------------------------

# ffprobe must be installed
if ! command -v ffprobe &> /dev/null; then
    echo -e "${RED}Error: ffprobe not found in PATH.${NC}"
    echo "Install FFmpeg (which contains ffprobe) and make sure it is in your PATH."
    echo "See the header of this script for installation instructions."
    exit 1
fi

# Source folder must exist
if [ ! -d "$SOURCE_DIR" ]; then
    echo -e "${RED}Error: source folder '$SOURCE_DIR' does not exist.${NC}"
    exit 1
fi

# Create destination folder if needed
mkdir -p "$DEST_DIR"

# ---- Helpers ---------------------------------------------------------------

# Sanitize a folder name for Windows compatibility.
# Replaces  \ / : * ? " < > |  with underscore, trims spaces and dots.
sanitize_name() {
    local name="$1"
    name=$(echo "$name" | sed 's/[\\/:*?"<>|]/_/g')
    name=$(echo "$name" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    name=$(echo "$name" | sed 's/[. ]*$//')
    if [ -z "$name" ]; then
        name="Unknown"
    fi
    echo "$name"
}

# ---- Main loop -------------------------------------------------------------

echo -e "${YELLOW}Scanning : $SOURCE_DIR${NC}"
echo -e "${YELLOW}Output   : $DEST_DIR${NC}"
echo

count_moved=0
count_skipped=0

# Iterate over all audio files (case-insensitive extensions).
find "$SOURCE_DIR" -type f \
    \( -iname "*.mp3" -o -iname "*.flac" -o -iname "*.m4a" \
    -o -iname "*.ogg" -o -iname "*.wma" -o -iname "*.wav" \
    -o -iname "*.aiff" \) -print0 |
while IFS= read -r -d '' file; do

    # Skip files already inside the destination folder
    case "$file" in "$DEST_DIR"/*) continue ;; esac

    # --- Read tags ---
    # Prefer album_artist (useful for compilations), fall back to artist.
    artist=$(ffprobe -v error -show_entries format_tags=album_artist \
             -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null)
    if [ -z "$artist" ]; then
        artist=$(ffprobe -v error -show_entries format_tags=artist \
                 -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null)
    fi
    album=$(ffprobe -v error -show_entries format_tags=album \
             -of default=noprint_wrappers=1:nokey=1 "$file" 2>/dev/null)

    # --- Skip if essential tags are missing ---
    if [ -z "$artist" ] || [ -z "$album" ]; then
        echo -e "${RED}Skipped (missing tags): $(basename "$file")${NC}"
        continue
    fi

    # --- Sanitize and build target path ---
    clean_artist=$(sanitize_name "$artist")
    clean_album=$(sanitize_name "$album")
    target_dir="$DEST_DIR/$clean_artist/$clean_album"

    mkdir -p "$target_dir"

    # --- Move the file (never overwrite an existing file) ---
    if mv -n "$file" "$target_dir/" 2>/dev/null; then
        echo -e "${GREEN}Moved:${NC} $(basename "$file")  ->  $clean_artist/$clean_album"
    else
        echo -e "${RED}Error moving: $(basename "$file")${NC}"
    fi
done

echo
echo -e "${YELLOW}Done.${NC}"
echo -e "${YELLOW}Files are in: $DEST_DIR${NC}"
